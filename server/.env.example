HOST=127.0.0.1
PORT=8787
# How many hours the server keeps each message. Default 24. Values below 1 become 1.
# BOT_MESSAGE_TTL_HOURS=24
# When the reverse proxy is not on this machine, set its address so image links stay public https.
# The default trusts only 127.0.0.1 and ::1.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Database and image directory. The default is server/data, with proclan.sqlite3 and media/.
# PROCLAN_DATA_DIR=
