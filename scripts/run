#!/bin/sh
# Usage: ./scripts/run [device]
#        ./scripts/run dev [device]
#        ./scripts/run production [device]
# dev reads app/.env.development. production reads app/.env.production.
# Any other first argument is the device, and the file is app/.env.
# Default device is macos.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root/app"
envfile=.env
case "${1:-}" in
  dev)
    envfile=.env.development
    shift
    ;;
  production)
    envfile=.env.production
    shift
    ;;
esac
device=${1:-macos}
if [ ! -f "$envfile" ]; then
  echo "missing app/$envfile. Copy app/.env.example and set API_BASE." >&2
  exit 1
fi
exec flutter run -d "$device" --dart-define-from-file="$envfile"
